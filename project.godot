[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="hitbox"
3d_physics/layer_3="destructible"
3d_physics/layer_4="pickup"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/use_taa=true
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.071, 1)
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/screen_space_roughness_limiter/enabled=true
global_illumination/sdfgi/probe_ray_count=2
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=96

[debug]

gdscript/warnings/inference_on_variant=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
