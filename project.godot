; Engine configuration file.
config_version=5

[application]

config/name="משמרת לילה"
config/description="משחק יריות על מסילה — מהדורת PC"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/icon.svg"
boot_splash/bg_color=Color(0.043, 0.051, 0.071, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="mishmeret-layla"

[autoload]

Settings="*res://scripts/core/settings.gd"
Sfx="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/custom_font="res://assets/fonts/Rubik.ttf"
theme/default_font_antialiasing=1

[input]

